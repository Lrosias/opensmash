+#ifdef PORT
+// Errored ports must release cached controls as well as zero the pad.
+// Keep repeat settings, error/status and physical port identity intact.
+static void syControllerClearDisconnectedInput(s32 i)
+{
+    sSYControllerDescs[i].unk00 = sSYControllerDescs[i].unk02 = sSYControllerDescs[i].unk04 = 0;
+    sSYControllerDescs[i].unk06 = sSYControllerDescs[i].unk08 = sSYControllerDescs[i].unk0A = 0;
+    sSYControllerDescs[i].unk0C = 0;
+    sSYControllerDescs[i].unk0E = sSYControllerDescs[i].unk0F = 0;
+    sSYControllerDescs[i].unk18 = sSYControllerDescs[i].unk10;
+    gSYControllerDevices[i] = (SYController){0};
+}
+#endif
+
 // 0x80003DD4
 void syControllerReadDeviceData(void)
 {
@@ -194,8 +209,8 @@ void syControllerReadDeviceData(void)
     osContGetReadData(sSYControllerData);
 #ifdef PORT
     syControllerApplyPadScript();
-    /* Browser port map (port/web_input.cpp): keyboard/gamepad/nothing per
-     * port, decided by the shell. No-op on native and when not engaged. */
+    /* Platform input map: browser devices or an owned native raw adapter.
+     * Unowned native slots retain the existing SDL/keyboard samples. */
