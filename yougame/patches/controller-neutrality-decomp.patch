         extern void port_input_apply_pads(void *pads);
         port_input_apply_pads(sSYControllerData);
@@ -243,6 +258,12 @@ void syControllerReadDeviceData(void)
             sSYControllerDescs[i].unk0C |= sSYControllerDescs[i].unk0A;
             sSYControllerDescs[i].unk08 |= sSYControllerDescs[i].unk06;
         }
+#ifdef PORT
