@@ -320,9 +347,26 @@ void syControllerUpdateGlobalData(void)
 
             sSYControllerDescs[i].unk04 = sSYControllerDescs[i].unk08 = sSYControllerDescs[i].unk0C = 0;
         }
+#ifdef PORT
