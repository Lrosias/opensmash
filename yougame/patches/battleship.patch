 	char *c_stack;
 	char *asyncify_stack;
 	size_t asyncify_size;
+	PortCoroutine *snapshot_next;
 };
 
 /* The fiber representing the main thread's original context. */
+static PortCoroutine *sSnapshotCoroutines = NULL;
 static emscripten_fiber_t sMainFiber;
 static char sMainAsyncifyStack[ASYNCIFY_STACK_MIN];
 static int sMainInitialized = 0;
@@ -167,6 +169,8 @@ PortCoroutine *port_coroutine_create(void (*entry)(void *), void *arg,
 	emscripten_fiber_init(&co->fiber, fiber_entry, co, co->c_stack, stack_size,
 	                      co->asyncify_stack, co->asyncify_size);
 
+	co->snapshot_next = sSnapshotCoroutines;
+	sSnapshotCoroutines = co;
 	return co;
 }
 
@@ -179,6 +183,9 @@ void port_coroutine_destroy(PortCoroutine *co)
 		fprintf(stderr, "SSB64: port_coroutine_destroy on current coroutine\n");
 		abort();
 	}
+	PortCoroutine **link = &sSnapshotCoroutines;
+	while (*link && *link != co) link = &(*link)->snapshot_next;
+	if (*link) *link = co->snapshot_next;
 	free(co->c_stack);
 	free(co->asyncify_stack);
 	free(co);
@@ -234,4 +241,27 @@ int port_coroutine_in_coroutine(void)
 	return sCurrentCoroutine != NULL;
 }
 
+/* A suspended fiber only owns the live portion of each stack. Omit complete
+ * pages of unused capacity from checkpoints; keep allocator metadata and the
+ * fiber record itself. Called only after the frame has returned to JavaScript.
+ * The skipped bytes cannot be read by a resumed frame before being initialized. */
+extern "C" EMSCRIPTEN_KEEPALIVE uintptr_t *port_yougame_stack_exclusions(void)
+{
+    static uintptr_t ranges[8193];
+    unsigned n = 0;
+    if (sCurrentCoroutine) { ranges[0] = 0; return ranges; }
+    // We have returned to JS: the main stack below its last suspension is
+    // unused too. Keep the former live part and all stack/fiber metadata.
+    ranges[++n] = (uintptr_t)sMainFiber.stack_limit;
+    ranges[++n] = (uintptr_t)sMainFiber.stack_ptr;
+    for (PortCoroutine *co = sSnapshotCoroutines; co; co = co->snapshot_next) {
+        if (n + 4 > 8192) { ranges[0] = 0; return ranges; }
+        ranges[++n] = (uintptr_t)co->c_stack;
+        ranges[++n] = (uintptr_t)co->fiber.stack_ptr;
+        ranges[++n] = (uintptr_t)co->fiber.asyncify_data.stack_ptr;
+        ranges[++n] = (uintptr_t)co->asyncify_stack + co->asyncify_size;
+    }
+    ranges[0] = n;
+    return ranges;
+}
 #endif /* __EMSCRIPTEN__ */
