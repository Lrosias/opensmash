+#ifdef __EMSCRIPTEN__
+	/* Stop retaining diagnostics at the cap. Gameplay must never grow a
+	 * MEMFS backing array indefinitely or format messages after the cap. */
+	if (ftell(sLogFile) >= 1024 * 1024) return;
+	char line[1024];
+	va_list browserArgs;
+	va_start(browserArgs, fmt);
+	int length = vsnprintf(line, sizeof(line), fmt, browserArgs);
+	va_end(browserArgs);
+	if (length > 0) {
+		size_t remaining = 1024 * 1024 - (size_t)ftell(sLogFile);
+		size_t count = (size_t)length < sizeof(line) ? (size_t)length : sizeof(line) - 1;
+		fwrite(line, 1, count < remaining ? count : remaining, sLogFile);
+	}
+	return;
+#endif
