 		fprintf(stderr, "SSB64: port_coroutine_destroy on current coroutine\n");
 		abort();
 	}
+	PortCoroutine **link = &sSnapshotCoroutines;
+	while (*link && *link != co) link = &(*link)->snapshot_next;
+	if (*link) *link = co->snapshot_next;
 	free(co->c_stack);
 	free(co->asyncify_stack);
