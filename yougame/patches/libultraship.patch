+bool Interpreter::EnsureTextureUploadCapacity(uint64_t bytes) {
+    if (bytes > 256ull * 1024 * 1024) {
+        SPDLOG_ERROR("Texture upload exceeds supported capacity");
+        return false;
+    }
+    if (bytes <= mTexUploadCapacity) return true;
+    size_t capacity = mTexUploadCapacity ? mTexUploadCapacity : 65536;
+    while (capacity < bytes) capacity *= 2;
+    uint8_t* next = (uint8_t*)realloc(mTexUploadBuffer, capacity);
+    if (!next) { SPDLOG_ERROR("Could not allocate texture upload buffer"); return false; }
+    mTexUploadBuffer = next;
+    mTexUploadCapacity = capacity;
+#ifdef __EMSCRIPTEN__
+    /* The bounds live in Wasm memory so a rollback restores them together
+     * with allocator metadata. JS must not retain a speculative realloc. */
+    static uintptr_t range[2];
+    range[0] = (uintptr_t)mTexUploadBuffer;
+    range[1] = range[0] + mTexUploadCapacity;
+    EM_ASM({
+        const ptr = $0;
+        Object.defineProperty(Module, 'yougameTextureScratch', {
+            configurable: true, get() { return [HEAPU32[ptr >> 2], HEAPU32[(ptr >> 2) + 1]]; }
+        });
+    }, range);
+#endif
+    return true;
+}
