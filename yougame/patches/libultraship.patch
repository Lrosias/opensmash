diff --git a/src/fast/interpreter.cpp b/src/fast/interpreter.cpp
index 08c954b..225ba63 100644
--- a/src/fast/interpreter.cpp
+++ b/src/fast/interpreter.cpp
@@ -1,4 +1,7 @@
 #include <chrono>
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
 #ifdef __wasm_simd128__
 #include <wasm_simd128.h>
 #endif
@@ -7105,6 +7108,13 @@ void Interpreter::Init(class GfxWindowBackend* wapi, class GfxRenderingAPI* rapi
         // We cap texture max to 8k, because why would you need more?
         int max_tex_size = std::min(8192, mRapi->GetMaxTextureSize());
         mTexUploadBuffer = (uint8_t*)malloc(max_tex_size * max_tex_size * 4);
+#ifdef __EMSCRIPTEN__
+        // Upload conversion scratch is fully written before each texture upload.
+        // It has no state between frames; omit its potentially 256 MB capacity
+        // from local rollback checkpoints (the allocation itself stays live).
+        EM_ASM({ Module.yougameTextureScratch = Array.of($0, $0 + $1); },
+               mTexUploadBuffer, max_tex_size * max_tex_size * 4);
+#endif
     }
 
     ucode_handler_index = UcodeHandlers::ucode_f3dex2;
